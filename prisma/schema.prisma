generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  DEVELOPER
}

enum WorkMode {
  OFFICE
  WFH
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  HOLIDAY
  WEEKEND
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AssignmentRole {
  LEAD
  DEVELOPER
  DESIGNER
  QA
  CONTRIBUTOR
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum LeavePeriod {
  MONTHLY
  ANNUAL
}

model Employee {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  title         String?
  department    String?
  joinedAt      DateTime @default(now())
  active        Boolean  @default(true)
  avatarColor   String   @default("#6366f1")

  role          Role     @default(DEVELOPER)
  passwordHash  String
  mustChangePassword Boolean @default(true)

  // Dev account references — identifiers/links only, never credentials
  githubUsername   String?
  claudeAccountLabel String?
  vercelUsername   String?

  attendance      Attendance[]
  assignments     ProjectAssignment[]
  leaves          LeaveRequest[]
  reviewedLeaves  LeaveRequest[] @relation("LeaveReviewedBy")
  managedProjects Project[]      @relation("ProjectManager")
  createdTasks    Task[]         @relation("TaskCreatedBy")
  assignedTasks   Task[]         @relation("TaskAssignedTo")
  activity        ActivityLog[]
  notifications   Notification[]
  taskComments    TaskComment[]
  dailyUpdates    DailyWorkUpdate[]
  conversations   ConversationParticipant[]
  messages        Message[]
  reviewedLeavePolicyChanges LeavePolicy[] @relation("LeavePolicyUpdatedBy")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Attendance {
  id          String            @id @default(cuid())
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  date        DateTime          // day this record applies to (date-only, stored at midnight)
  status      AttendanceStatus  @default(PRESENT)
  workMode    WorkMode          @default(OFFICE)
  clockIn     DateTime?
  clockOut    DateTime?
  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  type        String      @default("Personal")
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)

  reviewedBy   Employee? @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  createdAt   DateTime @default(now())
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  description String?
  status      ProjectStatus @default(PLANNING)
  // Progress is computed from task completion by default; set this to
  // override with a manual percentage (OWNER/MANAGER only).
  progressOverride Int?
  startDate   DateTime?
  deadline    DateTime?
  githubRepoUrl String?
  vercelProjectUrl String?

  manager     Employee? @relation("ProjectManager", fields: [managerId], references: [id])
  managerId   String?

  assignments ProjectAssignment[]
  tasks       Task[]
  milestones  Milestone[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectAssignment {
  id          String         @id @default(cuid())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  role        AssignmentRole @default(CONTRIBUTOR)

  // Per-assignment dev-account context (optional override of employee defaults)
  githubRepoUrl     String?
  vercelProjectUrl  String?

  active      Boolean   @default(true)
  assignedAt  DateTime  @default(now())
  removedAt   DateTime?

  @@unique([projectId, employeeId])
}

model Task {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?

  assignedTo   Employee? @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?
  createdBy    Employee  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById  String

  // Acknowledgment lifecycle, tracked alongside `status` so the PM can tell
  // a task was actually seen, independent of work having started.
  reviewedAt  DateTime?
  acceptedAt  DateTime?

  comments    TaskComment[]

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TaskComment {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model DailyWorkUpdate {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  date       DateTime // day this update is for, stored at UTC midnight
  completed  String?
  inProgress String?
  blocked    String?
  tomorrow   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([employeeId, date])
}

model Conversation {
  id           String                    @id @default(cuid())
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String
  lastReadAt     DateTime?

  @@unique([conversationId, employeeId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         Employee     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model LeavePolicy {
  id                 String      @id @default(cuid())
  name               String      @unique
  period             LeavePeriod @default(ANNUAL)
  monthlyAllowance    Int?
  annualAllowance     Int?
  carryForward        Boolean     @default(false)
  maxCarryForward     Int?
  active              Boolean     @default(true)

  updatedBy   Employee? @relation("LeavePolicyUpdatedBy", fields: [updatedById], references: [id])
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttendanceConfig {
  id              String @id @default("singleton")
  officeStartTime String @default("09:30") // "HH:MM", 24-hour
  graceMinutes    Int    @default(15)
  updatedAt       DateTime @updatedAt
}

model Milestone {
  id          String          @id @default(cuid())
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  name        String
  description String?
  startDate   DateTime?
  dueDate     DateTime?
  status      MilestoneStatus @default(NOT_STARTED)
  progress    Int             @default(0)
  order       Int             @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id          String   @id @default(cuid())
  recipient   Employee @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId String
  type        String
  message     String
  entityType  String?
  entityId    String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
}

model ActivityLog {
  id         String   @id @default(cuid())
  actor      Employee @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
