generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  DEVELOPER
}

enum WorkMode {
  OFFICE
  WFH
}

enum AttendanceStatus {
  PRESENT
  LEAVE
  HOLIDAY
  WEEKEND
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum AssignmentRole {
  LEAD
  DEVELOPER
  DESIGNER
  QA
  CONTRIBUTOR
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  COMPLETED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Employee {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  title         String?
  department    String?
  joinedAt      DateTime @default(now())
  active        Boolean  @default(true)
  avatarColor   String   @default("#6366f1")

  role          Role     @default(DEVELOPER)
  passwordHash  String
  mustChangePassword Boolean @default(true)

  // Dev account references — identifiers/links only, never credentials
  githubUsername   String?
  claudeAccountLabel String?
  vercelUsername   String?

  attendance      Attendance[]
  assignments     ProjectAssignment[]
  leaves          LeaveRequest[]
  reviewedLeaves  LeaveRequest[] @relation("LeaveReviewedBy")
  managedProjects Project[]      @relation("ProjectManager")
  createdTasks    Task[]         @relation("TaskCreatedBy")
  assignedTasks   Task[]         @relation("TaskAssignedTo")
  activity        ActivityLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Attendance {
  id          String            @id @default(cuid())
  employee    Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  date        DateTime          // day this record applies to (date-only, stored at midnight)
  status      AttendanceStatus  @default(PRESENT)
  workMode    WorkMode          @default(OFFICE)
  clockIn     DateTime?
  clockOut    DateTime?
  note        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, date])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  type        String      @default("Personal")
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus @default(PENDING)

  reviewedBy   Employee? @relation("LeaveReviewedBy", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?

  createdAt   DateTime @default(now())
}

model Project {
  id          String        @id @default(cuid())
  name        String
  client      String?
  description String?
  status      ProjectStatus @default(PLANNING)
  // Progress is computed from task completion by default; set this to
  // override with a manual percentage (OWNER/MANAGER only).
  progressOverride Int?
  startDate   DateTime?
  deadline    DateTime?
  githubRepoUrl String?
  vercelProjectUrl String?

  manager     Employee? @relation("ProjectManager", fields: [managerId], references: [id])
  managerId   String?

  assignments ProjectAssignment[]
  tasks       Task[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectAssignment {
  id          String         @id @default(cuid())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  employee    Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  role        AssignmentRole @default(CONTRIBUTOR)

  // Per-assignment dev-account context (optional override of employee defaults)
  githubRepoUrl     String?
  vercelProjectUrl  String?

  active      Boolean   @default(true)
  assignedAt  DateTime  @default(now())
  removedAt   DateTime?

  @@unique([projectId, employeeId])
}

model Task {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?

  assignedTo   Employee? @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?
  createdBy    Employee  @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById  String

  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  actor      Employee @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId    String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}
